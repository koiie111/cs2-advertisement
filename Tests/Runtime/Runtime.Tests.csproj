<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PluginSource Condition="'$(PluginSource)' == ''">../../Advertisement</PluginSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PluginSource)/*.cs" Link="Plugin/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
